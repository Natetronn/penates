{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penates",
  "identifier": "dev.penates.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "Penates",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Turn websites into native desktop apps",
    "longDescription": "Penates turns websites and PWAs into native desktop apps with their own window, icon, taskbar entry and isolated profile. Built with Rust and Tauri.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "icon": [
      "icons/icon.png"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMjYyQTIxREU4RUMwNUUKUldSZXdJN2VJU29tTGg4QWxZUExHYU1sRHg5bERSODl4K2JQeU9oWUpWaGtXOC9raC9QWTVSOS8K",
      "endpoints": [
        "https://github.com/Natetronn/penates-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
