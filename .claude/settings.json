{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(python3 design/preview/build.py)",
      "Bash(node --check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(python3 scripts/publish-release.py * --dry-run)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh workflow run *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)"
    ]
  }
}
