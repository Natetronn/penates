---
// The clickable manager (design/preview, copied to public/demo/manager.html by scripts/sync.mjs) under the
// site's top bar.
import Site from '../layouts/Site.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Site
  title="Try the Penates manager"
  description="The Penates manager with sample apps, running in your browser: create, edit and theme apps without installing anything."
  footer={false}
>
  <main class="demo">
    <iframe src={base + 'demo/manager.html'} title="Penates manager demo"></iframe>
  </main>
</Site>

<style>
  iframe { flex: 1; width: 100%; border: 0; border-top: 1px solid var(--line); display: block; background: var(--bg); }
</style>
