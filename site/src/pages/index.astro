---
// The home page. It has its own layout; the docs and guides use Starlight.
import '@fontsource-variable/space-grotesk';
import { Image } from 'astro:assets';
import lockupDark from '../assets/lockup-dark.svg';
import lockupLight from '../assets/lockup-light.svg';
import appsDark from '../assets/screens/manager-apps.png';
import appsLight from '../assets/screens/manager-apps-light.png';
import edit from '../assets/screens/manager-edit.png';
import settings from '../assets/screens/manager-settings.png';
import catalog from '../data/catalog.json';

const RELEASES = 'https://github.com/Natetronn/penates/releases/latest';
const REPO = 'https://github.com/Natetronn/penates';
const title = 'Penates: turn websites into desktop apps';
const description =
  'Penates turns websites and web apps into desktop apps, each with its own window, icon, taskbar entry and separate login. Free and open source, for Linux, Windows and macOS.';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path: string) => base + path;

const features = [
  {
    icon: 'window',
    title: 'A real app window',
    text: 'Its own taskbar entry and icon, a tray icon if you want one, and single-window mode. Start it as a window, minimized or only in the tray.',
  },
  {
    icon: 'lock',
    title: 'Separate logins',
    text: 'Every app keeps its own cookies and storage, so a work and a personal account run side by side.',
  },
  {
    icon: 'link',
    title: 'Links go where they belong',
    text: "The site's own pages and its sign-in popups stay in the app; links to other sites open in your browser.",
  },
  {
    icon: 'keys',
    title: 'Browser keys',
    text: 'Alt+← and Alt+→ or the mouse side buttons go back and forward; F5 and Ctrl+R reload.',
  },
  {
    icon: 'star',
    title: 'An app catalog',
    text: 'Known sites come with small fixes, like keeping sign-in inside the window. Share your own fixes back in a click.',
  },
  {
    icon: 'shield',
    title: 'Yours to keep',
    text: 'MIT licensed, signed updates, no account and no telemetry. Export your apps to a file and take them anywhere.',
  },
];

const icons: Record<string, string> = {
  window: 'M3 5h18v14H3zM3 9h18M6.5 7h.01M9 7h.01',
  lock: 'M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3',
  link: 'M14 4h6v6M20 4l-9 9M18 14v5H5V6h5',
  keys: 'M3 7h18v10H3zM7 11h.01M11 11h.01M15 11h.01M8 14h8',
  star: 'M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z',
  shield: 'M12 3l8 3v6c0 4.5-3.4 7.9-8 9-4.6-1.1-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5',
};

const platforms = [
  {
    os: 'linux',
    name: 'Linux',
    formats: 'AppImage, .deb, .rpm',
    note: 'On Arch: <code>paru -S penates-bin</code>, or <code>penates</code> to build from source.',
  },
  {
    os: 'windows',
    name: 'Windows',
    formats: 'Installer (.exe)',
    note: 'Not signed with a Microsoft certificate yet: if SmartScreen stops it, choose More info → Run anyway.',
  },
  {
    os: 'mac',
    name: 'macOS',
    formats: '.dmg for Apple silicon and Intel',
    note: 'macOS 14 or later. Not signed with an Apple certificate yet: allow it once under Privacy & Security.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#0c0b16" />
    <script is:inline>
      // Follow the theme chosen in the docs (Starlight stores it), else the system's.
      try {
        const t = localStorage.getItem('starlight-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={href('')} aria-label="Penates home">
          <Image src={lockupDark} alt="Penates" class="on-dark" height={30} loading="eager" />
          <Image src={lockupLight} alt="Penates" class="on-light" height={30} loading="eager" />
        </a>
        <nav aria-label="Main">
          <a href={href('getting-started/')}>Docs</a>
          <a href={href('apps/')} class="wide">Popular apps</a>
          <a href={href('demo/')} class="wide">Demo</a>
          <a href={REPO} class="icon-link" aria-label="Penates on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
          </a>
          <a href="#download" class="button small">Download</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="glow" aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Free and open source · Linux, Windows, macOS</p>
            <h1>Every site gets <span class="grad">a home of its own</span></h1>
            <p class="lede">
              Penates turns websites and web apps into desktop apps, each with its own window, icon, taskbar
              entry and separate login.
            </p>
            <div class="actions">
              <a href="#download" class="button" data-download>Download</a>
              <a href={href('demo/')} class="button ghost">Try it in your browser</a>
            </div>
          </div>
          <figure class="shot hero-shot">
            <Image src={appsDark} alt="The Penates manager listing five apps" class="on-dark" widths={[640, 1075]} sizes="(min-width: 900px) 560px, 100vw" loading="eager" />
            <Image src={appsLight} alt="The Penates manager listing five apps" class="on-light" widths={[640, 1075]} sizes="(min-width: 900px) 560px, 100vw" loading="eager" />
          </figure>
        </div>
      </section>

      <section class="wrap strip" aria-label="Apps in the catalog">
        <p>Ready-made fixes for</p>
        <ul>
          {catalog.map((app) => <li><a href={href('apps/')}>{app.name}</a></li>)}
        </ul>
        <p class="more">and any other site you paste in.</p>
      </section>

      <section class="wrap features">
        <h2>Websites that behave like apps</h2>
        <div class="grid">
          {features.map((f) => (
            <article class="card">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="ficon"><path d={icons[f.icon]} /></svg>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="wrap split">
        <div>
          <h2>One command, or a few clicks</h2>
          <p>
            Paste an address in the manager, or use the terminal. Penates finds the site's name and icon, adds the app to
            your application menu and links a catalog fix when there is one.
          </p>
          <pre class="term" aria-label="Terminal example"><code><span class="dim">$</span> penates create github.com
<span class="out">created 'GitHub' (github)
preset: github 1.1.0 from the app catalog
launcher: ~/.local/share/applications/penates-github.desktop</span>
<span class="dim">$</span> penates run github</code></pre>
          <p><a href={href('docs/cli/')} class="more-link">CLI reference →</a></p>
        </div>
        <figure class="shot">
          <Image src={edit} alt="Editing an app: name, address, icon, window and start options" widths={[640, 1075]} sizes="(min-width: 900px) 540px, 100vw" />
        </figure>
      </section>

      <section class="wrap split reverse">
        <div>
          <h2>Pick your look</h2>
          <p>
            Four looks, light or dark, and six accent colors for the manager. Every app keeps its own window size,
            zoom, tray icon, permissions and start mode.
          </p>
          <p><a href={href('docs/theming/')} class="more-link">How theming works →</a></p>
        </div>
        <figure class="shot">
          <Image src={settings} alt="Settings: looks, light or dark, accent colors and the app catalog" widths={[640, 1075]} sizes="(min-width: 900px) 540px, 100vw" />
        </figure>
      </section>

      <section class="wrap download" id="download">
        <h2>Download</h2>
        <p class="sub">Version numbers, checksums and every file are on the <a href={RELEASES}>releases page</a>. Penates updates itself, with signed updates.</p>
        <div class="platforms">
          {platforms.map((p) => (
            <a class="card platform" href={RELEASES} data-os={p.os}>
              <span class="pname">{p.name}</span>
              <span class="pformats">{p.formats}</span>
              <span class="pnote" set:html={p.note} />
              <span class="pget">Get it →</span>
            </a>
          ))}
        </div>
        <p class="sub">New here? <a href={href('getting-started/')}>Getting started</a> walks through your first app.</p>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <p>Penates is free software under the MIT License. Named for the Roman household gods who kept the hearth.</p>
        <nav aria-label="Footer">
          <a href={href('getting-started/')}>Docs</a>
          <a href={href('apps/')}>Popular apps</a>
          <a href={href('docs/sharing/')}>Sharing</a>
          <a href={REPO}>GitHub</a>
          <a href={`${REPO}/issues`}>Report a problem</a>
        </nav>
      </div>
    </footer>

    <script>
      // Point Download at this computer's system.
      const ua = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform || navigator.platform || navigator.userAgent;
      const os = /win/i.test(ua) ? 'windows' : /mac|iphone|ipad/i.test(ua) ? 'mac' : /linux|x11|cros/i.test(ua) ? 'linux' : '';
      const names: Record<string, string> = { windows: 'Windows', mac: 'macOS', linux: 'Linux' };
      if (os) {
        document.querySelector(`.platform[data-os="${os}"]`)?.classList.add('yours');
        const button = document.querySelector<HTMLAnchorElement>('[data-download]');
        if (button) button.textContent = `Download for ${names[os]}`;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f8f7fc;
    --bg-2: #efedf8;
    --card: #ffffff;
    --line: #e3e0f0;
    --fg: #17152a;
    --muted: #625e7a;
    --accent: #6d3fe0;
    --accent-fg: #ffffff;
    --grad: linear-gradient(100deg, #22e6ff, #8b5cff 50%, #ff4fd8);
    --glow-a: 0.18;
    --shadow: 0 24px 60px rgb(40 20 90 / 0.18);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0c0b16; --bg-2: #13111f; --card: #171527; --line: #2a2742; --fg: #f4f2ff; --muted: #a9a5c4;
      --accent: #9a76ff; --accent-fg: #0e1014; --glow-a: 0.35; --shadow: 0 30px 80px rgb(0 0 0 / 0.55);
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0c0b16; --bg-2: #13111f; --card: #171527; --line: #2a2742; --fg: #f4f2ff; --muted: #a9a5c4;
    --accent: #9a76ff; --accent-fg: #0e1014; --glow-a: 0.35; --shadow: 0 30px 80px rgb(0 0 0 / 0.55);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  a { color: var(--accent); }
  img { display: block; max-width: 100%; height: auto; }
  code { font: 0.9em ui-monospace, 'Cascadia Code', monospace; }
  h1, h2, h3, .pname { font-family: 'Space Grotesk Variable', system-ui, sans-serif; letter-spacing: -0.03em; line-height: 1.1; }
  h2 { font-size: clamp(1.7rem, 1.2rem + 2vw, 2.4rem); margin: 0 0 1rem; text-wrap: balance; }
  h3 { font-size: 1.15rem; margin: 0.9rem 0 0.4rem; }
  .wrap { width: min(1120px, 100% - 2rem); margin-inline: auto; }

  /* theme-specific images */
  .on-light { display: none; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .on-dark { display: none; }
    :root:not([data-theme='dark']) .on-light { display: block; }
  }
  :root[data-theme='light'] .on-dark { display: none; }
  :root[data-theme='light'] .on-light { display: block; }

  /* top bar */
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 1rem; }
  .brand img { height: 30px; width: auto; }
  .top nav { display: flex; align-items: center; gap: 1.4rem; }
  .top nav a:not(.button) { color: var(--fg); text-decoration: none; font-weight: 500; opacity: 0.85; }
  .top nav a:not(.button):hover { opacity: 1; color: var(--accent); }
  .icon-link svg { width: 22px; height: 22px; display: block; }
  @media (max-width: 640px) { .top nav .wide { display: none; } .top nav { gap: 1rem; } }

  /* buttons */
  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.8rem 1.4rem; border-radius: 999px; font-weight: 600; text-decoration: none;
    background: var(--accent); color: var(--accent-fg); border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .button:hover { transform: translateY(-1px); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 35%, transparent); }
  .button.ghost { background: transparent; color: var(--fg); border-color: var(--line); }
  .button.ghost:hover { border-color: var(--accent); box-shadow: none; }
  .button.small { padding: 0.45rem 1rem; font-size: 0.92rem; }

  /* hero */
  .hero { position: relative; padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .glow {
    position: absolute; inset: -10% -20% auto; height: 120%; pointer-events: none; opacity: var(--glow-a);
    background:
      radial-gradient(40% 45% at 72% 38%, #8b5cff, transparent 70%),
      radial-gradient(30% 35% at 88% 18%, #ff4fd8, transparent 70%),
      radial-gradient(30% 35% at 58% 62%, #22e6ff, transparent 70%);
    filter: blur(40px);
  }
  .hero-grid { position: relative; display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1fr 1.05fr; } }
  .eyebrow { margin: 0 0 1rem; font-size: 0.9rem; font-weight: 600; color: var(--muted); letter-spacing: 0.02em; }
  h1 { font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.6rem); margin: 0 0 1.2rem; font-weight: 700; text-wrap: balance; }
  h1 .grad { display: inline-block; }
  .grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem); color: var(--muted); max-width: 34rem; margin: 0 0 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  /* screenshots */
  .shot { margin: 0; }
  .shot img { border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  /* The app list fills the top of its window: show that part and fade out below the last app. */
  .hero-shot {
    aspect-ratio: 1075 / 700; overflow: hidden; border-radius: 12px 12px 0 0;
    border: 1px solid var(--line); border-bottom: 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 87%, transparent);
    mask-image: linear-gradient(to bottom, #000 87%, transparent);
  }
  .hero-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; border: 0; border-radius: 0; box-shadow: none; }

  /* catalog strip */
  .strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.6rem 1rem;
    padding: 1.4rem 0 3.5rem; color: var(--muted); font-size: 0.95rem;
  }
  .strip p { margin: 0; }
  .strip ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .strip li a {
    display: block; padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid var(--line);
    background: var(--card); color: var(--fg); text-decoration: none; font-weight: 500; font-size: 0.9rem;
  }
  .strip li a:hover { border-color: var(--accent); }

  /* features */
  .features { padding: 3rem 0; }
  .features h2 { text-align: center; margin-bottom: 2.2rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1.4rem 1.5rem; }
  .card p { margin: 0; color: var(--muted); }
  .ficon {
    width: 40px; height: 40px; padding: 8px; border-radius: 10px; fill: none; stroke: #fff; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; background: var(--grad);
  }

  /* text + screenshot rows */
  .split { display: grid; gap: 2.5rem; align-items: center; padding: 3.5rem 0; }
  .split > *, .hero-grid > * { min-width: 0; }
  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1.15fr; gap: 4rem; }
    .split.reverse > div { order: 2; }
  }
  .split p { color: var(--muted); font-size: 1.05rem; }
  .more-link { font-weight: 600; text-decoration: none; }
  .term {
    margin: 1.4rem 0; padding: 1.1rem 1.3rem; border-radius: 12px; overflow-x: auto;
    background: #0c0b16; color: #f4f2ff; border: 1px solid #2a2742; font-size: 0.95rem; line-height: 1.7;
    box-shadow: inset 0 2px 0 0 transparent; position: relative;
  }
  .term::before { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: var(--grad); border-radius: 12px 12px 0 0; }
  .term .dim { color: #8f8aad; user-select: none; }
  .term .out { color: #a9a5c4; }

  /* download */
  .download { padding: 4rem 0 5rem; text-align: center; scroll-margin-top: 80px; }
  .download .sub { color: var(--muted); max-width: 40rem; margin: 0 auto 2rem; }
  .download .sub:last-child { margin: 2rem auto 0; }
  .platforms { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); text-align: left; }
  .platform { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: var(--fg); transition: border-color 0.15s ease, transform 0.15s ease; }
  .platform:hover { border-color: var(--accent); transform: translateY(-2px); }
  .platform.yours { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), var(--shadow); }
  .pname { font-size: 1.4rem; font-weight: 700; }
  .pformats { font-weight: 600; }
  .pnote { color: var(--muted); font-size: 0.92rem; flex: 1; }
  .pnote code { background: var(--bg-2); padding: 0.1em 0.35em; border-radius: 4px; }
  .pget { color: var(--accent); font-weight: 600; margin-top: 0.6rem; }

  /* footer */
  .foot { border-top: 1px solid var(--line); background: var(--bg-2); padding: 2rem 0; font-size: 0.92rem; color: var(--muted); }
  .foot-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; align-items: center; }
  .foot p { margin: 0; max-width: 36rem; }
  .foot nav { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .button, .platform { transition: none; }
  }
</style>
