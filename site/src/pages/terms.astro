---
// Plain terms for a free, open-source project: the license, no warranty, other sites' terms, no affiliation.
import Site from '../layouts/Site.astro';
import FinePrint from '../components/FinePrint.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const REPO = 'https://github.com/Natetronn/penates';
---
<Site page="terms">
  <FinePrint title="Terms" updated="2026-11-15">
    <h2>The software</h2>
    <p>Penates is free software under the <a href={`${REPO}/blob/main/LICENSE`}>MIT License</a>: you may use, copy, change and share it, as that license says. It is provided as is, without warranty of any kind. The components it is built from keep their own licenses (see <a href={base + 'credits/'}>Credits</a>).</p>

    <h2>Sites you use through Penates</h2>
    <p>Penates shows websites in their own windows. Using a site through Penates is still using that site: its own terms apply, and you are responsible for following them. Penates is not affiliated with, endorsed by or sponsored by any of the sites in its app catalog. Their names and logos belong to their owners and appear only to identify them.</p>

    <h2>The app catalog</h2>
    <p>Catalog entries are small settings shared by the community. They are reviewed before they are added, but provided as is. They can never add JavaScript to a site.</p>

    <h2>This website</h2>
    <p>The website and docs are part of the Penates project and under the same MIT License, except for third-party names and logos, and the Space Grotesk typeface (SIL Open Font License). They describe the latest release of Penates.</p>

    <h2>Changes and contact</h2>
    <p>These terms may change with the project; the date above says when they last did. Questions: <a href="mailto:hello@getpenates.com">hello@getpenates.com</a>.</p>
  </FinePrint>
</Site>
